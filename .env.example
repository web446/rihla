# Copy this file to ".env" and fill in the values.
# ".env" is listed in .gitignore, so your real secrets never reach GitHub.

# Used by Flask to sign the session cookie. Any long random string.
# Generate one with:  py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Leave empty to use the local SQLite file (instance/rihla.db).
# On Render this is filled in automatically with a PostgreSQL address.
DATABASE_URL=

# AI travel agent: claude | openai | none   (none = rule-based demo mode)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# Maximum chat messages per traveler per hour (controls AI cost)
CHAT_LIMIT_PER_HOUR=20
