# Copy this file to ".env" and fill in the values.
# ".env" is listed in .gitignore, so your real secrets never reach GitHub.

# Used by Flask to sign the session cookie. Any long random string.
# Generate one with:  py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Leave empty to use the local SQLite file (instance/rihla.db).
# On Render this is filled in automatically with a PostgreSQL address.
DATABASE_URL=

# AI travel agent:
#   "gemini" = Google Gemini API, free tier (key: https://aistudio.google.com -> Get API key)
#   "claude" = Claude API, paid (key: https://platform.claude.com -> API Keys)
#   "none"   = the rule-based demo mode, no key needed
# Never put the key in JavaScript or commit it.
AI_PROVIDER=none
AI_API_KEY=
# Model: leave empty for the default of the provider (gemini-3.8-flash or claude-opus-5-5).
AI_MODEL=
# How much the model "thinks" before answering (low | medium | high).
AI_EFFORT=medium

# Maximum chat messages per traveler per hour (controls AI cost)
CHAT_LIMIT_PER_HOUR=20
